{
  "rootDir": "..",
  "testMatch": ["<rootDir>/test/e2e/**/*.e2e-spec.ts"],
  "moduleFileExtensions": ["js", "json", "ts"],
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.test.json" }]
  },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/e2e/setup-env.cjs"],
  "maxWorkers": 1,
  "testTimeout": 30000
}
