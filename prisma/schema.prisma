generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT

  @@map("user_role")
}

enum PresenceStatus {
  ONLINE
  BUSY
  AWAY
  OFFLINE

  @@map("presence_status")
}

enum ConversationStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED

  @@map("conversation_status")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@map("message_direction")
}

enum MessageSenderType {
  CUSTOMER
  AGENT
  PAGE

  @@map("message_sender_type")
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  STICKER
  OTHER

  @@map("message_type")
}

enum AssignmentType {
  ROUND_ROBIN
  MANUAL
  TRANSFER
  AUTO_REASSIGN
  REOPEN

  @@map("assignment_type")
}

model User {
  id                    String                   @id @default(uuid()) @db.Uuid
  email                 String                   @unique @db.VarChar(320)
  passwordHash          String                   @map("password_hash") @db.VarChar(255)
  fullName              String                   @map("full_name") @db.VarChar(160)
  role                  UserRole
  isActive              Boolean                  @default(true) @map("is_active")
  lastLoginAt           DateTime?                @map("last_login_at") @db.Timestamptz(6)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  agentProfile          AgentProfile?
  assignedConversations Conversation[]           @relation("AssignedAgent")
  assignmentsFrom       ConversationAssignment[] @relation("AssignmentFrom")
  assignmentsTo         ConversationAssignment[] @relation("AssignmentTo")
  assignmentsMade       ConversationAssignment[] @relation("AssignmentActor")
  messagesSent          Message[]                @relation("MessageSender")
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  routingStates         RoutingState[]           @relation("RoutingCursorAgent")

  @@index([role, isActive])
  @@map("users")
}

model AgentProfile {
  userId                 String         @id @map("user_id") @db.Uuid
  presenceStatus         PresenceStatus @default(OFFLINE) @map("presence_status")
  acceptingConversations Boolean        @default(false) @map("accepting_conversations")
  maxActiveConversations Int            @default(10) @map("max_active_conversations")
  lastSeenAt             DateTime?      @map("last_seen_at") @db.Timestamptz(6)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageMemberships        PageAgent[]

  @@map("agent_profiles")
}

model FacebookPage {
  id            String         @id @default(uuid()) @db.Uuid
  metaPageId    String         @unique @map("meta_page_id") @db.VarChar(128)
  name          String         @db.VarChar(200)
  category      String?        @db.VarChar(160)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  agents        PageAgent[]
  contacts      Contact[]
  conversations Conversation[]
  routingState  RoutingState?

  @@map("facebook_pages")
}

model PageAgent {
  pageId                 String       @map("page_id") @db.Uuid
  agentId                String       @map("agent_id") @db.Uuid
  isEnabled              Boolean      @default(true) @map("is_enabled")
  maxActiveConversations Int?         @map("max_active_conversations")
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  page                   FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  agent                  AgentProfile @relation(fields: [agentId], references: [userId], onDelete: Cascade)

  @@id([pageId, agentId])
  @@index([agentId, isEnabled])
  @@map("page_agents")
}

model Contact {
  id                String         @id @default(uuid()) @db.Uuid
  pageId            String         @map("page_id") @db.Uuid
  metaPsid          String         @map("meta_psid") @db.VarChar(128)
  displayName       String?        @map("display_name") @db.VarChar(200)
  profilePictureUrl String?        @map("profile_picture_url") @db.Text
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  page              FacebookPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  conversations     Conversation[]

  @@unique([pageId, metaPsid])
  @@index([pageId, displayName])
  @@map("contacts")
}

model Conversation {
  id                 String                   @id @default(uuid()) @db.Uuid
  pageId             String                   @map("page_id") @db.Uuid
  contactId          String                   @map("contact_id") @db.Uuid
  metaConversationId String?                  @map("meta_conversation_id") @db.VarChar(160)
  assignedAgentId    String?                  @map("assigned_agent_id") @db.Uuid
  status             ConversationStatus       @default(UNASSIGNED)
  assignedAt         DateTime?                @map("assigned_at") @db.Timestamptz(6)
  openedAt           DateTime                 @default(now()) @map("opened_at") @db.Timestamptz(6)
  firstResponseAt    DateTime?                @map("first_response_at") @db.Timestamptz(6)
  lastMessageAt      DateTime?                @map("last_message_at") @db.Timestamptz(6)
  resolvedAt         DateTime?                @map("resolved_at") @db.Timestamptz(6)
  closedAt           DateTime?                @map("closed_at") @db.Timestamptz(6)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  page               FacebookPage             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  contact            Contact                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedAgent      User?                    @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages           Message[]
  assignments        ConversationAssignment[]

  @@index([pageId, status, lastMessageAt])
  @@index([assignedAgentId, status, lastMessageAt])
  @@index([contactId, status])
  @@map("conversations")
}

model Message {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  metaMessageId  String?           @unique @map("meta_message_id") @db.VarChar(200)
  direction      MessageDirection
  senderType     MessageSenderType @map("sender_type")
  senderId       String?           @map("sender_id") @db.Uuid
  messageType    MessageType       @default(TEXT) @map("message_type")
  content        String?           @db.Text
  metadata       Json?             @db.JsonB
  sentAt         DateTime          @map("sent_at") @db.Timestamptz(6)
  deliveredAt    DateTime?         @map("delivered_at") @db.Timestamptz(6)
  readAt         DateTime?         @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?             @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, sentAt, id])
  @@map("messages")
}

model ConversationAssignment {
  id               String         @id @default(uuid()) @db.Uuid
  conversationId   String         @map("conversation_id") @db.Uuid
  fromAgentId      String?        @map("from_agent_id") @db.Uuid
  toAgentId        String         @map("to_agent_id") @db.Uuid
  assignmentType   AssignmentType @map("assignment_type")
  assignedByUserId String?        @map("assigned_by_user_id") @db.Uuid
  reason           String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation     Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromAgent        User?          @relation("AssignmentFrom", fields: [fromAgentId], references: [id], onDelete: SetNull)
  toAgent          User           @relation("AssignmentTo", fields: [toAgentId], references: [id], onDelete: Restrict)
  assignedBy       User?          @relation("AssignmentActor", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([toAgentId, createdAt])
  @@map("conversation_assignments")
}

model RoutingState {
  pageId              String       @id @map("page_id") @db.Uuid
  lastAssignedAgentId String?      @map("last_assigned_agent_id") @db.Uuid
  version             Int          @default(0)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  page                FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  lastAssignedAgent   User?        @relation("RoutingCursorAgent", fields: [lastAssignedAgentId], references: [id], onDelete: SetNull)

  @@map("routing_state")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.VarChar(128)
  userAgent  String?   @map("user_agent") @db.Text
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(120)
  resourceType String   @map("resource_type") @db.VarChar(120)
  resourceId   String?  @map("resource_id") @db.VarChar(160)
  metadata     Json?    @db.JsonB
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
