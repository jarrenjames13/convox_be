NODE_ENV=development
PORT=4000

# ── Option A: local PostgreSQL ────────────────────────────────────────────
# Used automatically whenever DATABASE_URL (below) is not set.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=convox_db
# Prisma CLI reads DATABASE_URL directly; runtime also supports the DB_* values above.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/convox_db?schema=public
# DB_SSL=false                     # optional override — auto-detected as
#                                     false for localhost, no need to set it

# ── Option B: Supabase (or any managed Postgres) ──────────────────────────
# Setting DATABASE_URL takes priority over the DB_* vars above.
# Get this from: Supabase dashboard → Project Settings → Database → Connection string.
#
# Use the pooled connection (port 6543, pgbouncer) for normal app traffic,
# and the direct connection (port 5432) when running Prisma migrations —
# migrations can behave oddly through the transaction pooler.
#
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# DB_SSL=true                      # optional override — auto-detected as
#                                     true for any non-localhost host
# DB_SSL_REJECT_UNAUTHORIZED=true  # Supabase's cert validates cleanly; safe to enable

DB_POOL_MAX=10

JWT_ACCESS_SECRET=replace-this-with-a-random-64-character-secret-before-starting
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_PEPPER=replace-this-with-another-random-64-character-secret
REFRESH_TOKEN_TTL_DAYS=30
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000

META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0

# TEMPORARY DEVELOPMENT CONFIGURATION
# These variables exist only for the single development Facebook Page.
# Retire them once database-backed Facebook Page management is implemented.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

CONVERSATION_REOPEN_WINDOW_HOURS=24

# Development seed credentials (set explicitly before running `pnpm db:seed`).
# SEED_ADMIN_EMAIL=admin@convox.local
# SEED_ADMIN_PASSWORD=
# SEED_AGENT_PASSWORD=
